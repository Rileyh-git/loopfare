# Server
PORT=4021
HOST=0.0.0.0
PUBLIC_URL=http://localhost:4021
DATABASE_PATH=./data/loopfare.db

# Network: base-sepolia (testnet) or base (mainnet)
LOOPFARE_NETWORK=base-sepolia
# Facilitator: free testnet facilitator (no signup)
FACILITATOR_URL=https://x402.org/facilitator
# For mainnet / CDP, use: https://api.cdp.coinbase.com/platform/v2/x402
# and set CDP_API_KEY_ID / CDP_API_KEY_SECRET

# Default receiving wallet for demo endpoint (Base address)
DEMO_PAY_TO=0x0000000000000000000000000000000000000000

# Dev mode: accept LOOPFARE-DEV-PAYMENT header instead of real x402 (local only)
LOOPFARE_DEV_MODE=true

# Optional admin seed key (created on first boot if unset)
# ADMIN_API_KEY=
