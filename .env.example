# Server
NODE_ENV=development
PORT=4021
HOST=0.0.0.0
PUBLIC_URL=http://localhost:4021
DATABASE_PATH=./data/loopfare.db

# Network: base-sepolia (testnet) or base (mainnet)
LOOPFARE_NETWORK=base-sepolia
# Facilitator: free testnet facilitator (no signup)
FACILITATOR_URL=https://x402.org/facilitator
# Mainnet requires an authenticated, mainnet-capable facilitator integration.
# Keep the public beta on Base Sepolia until docs/PRODUCTION.md is complete.

# Default receiving wallet for demo endpoint (Base address)
DEMO_PAY_TO=0x0000000000000000000000000000000000000000

# Dev mode: accept LOOPFARE-DEV-PAYMENT header instead of real x402 (local only)
LOOPFARE_DEV_MODE=true

# Local development may proxy localhost/private origins. Keep false in production.
ALLOW_PRIVATE_ORIGINS=true

# Seller access and HTTP safety
SIGNUP_ENABLED=true
CORS_ORIGINS=http://localhost:4021
PROXY_TIMEOUT_MS=30000
MAX_REQUEST_BODY_BYTES=1048576
MAX_PROXY_RESPONSE_BYTES=10485760

# Optional deterministic owner key (no bootstrap account is created when unset)
# ADMIN_API_KEY=

# First-party, privacy-preserving usage analytics
USAGE_TRACKING_ENABLED=true
USAGE_RETENTION_DAYS=365
