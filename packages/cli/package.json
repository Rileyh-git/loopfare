{
  "name": "@loopfare/cli",
  "version": "0.2.1",
  "description": "Budget-aware x402 CLI for Loopfare on Base",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rileyh-git/loopfare.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Rileyh-git/loopfare#readme",
  "bugs": {
    "url": "https://github.com/Rileyh-git/loopfare/issues"
  },
  "keywords": [
    "x402",
    "base",
    "usdc",
    "payments",
    "cli",
    "ai-agents"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "loopfare": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@x402/core": "^2.18.0",
    "@x402/evm": "^2.18.0",
    "@x402/fetch": "^2.18.0",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "viem": "^2.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
