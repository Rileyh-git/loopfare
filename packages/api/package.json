    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.13",
    "nanoid": "^5.1.5",
    "undici": "^8.12.2",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2"
  }
